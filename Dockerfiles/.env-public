# Ports
GRADIO_PORT=7860
IMAGE_REVIEWER_PORT=7861

# Default host user/group IDs for container UID/GID mapping.
# shoptalk_shell.sh exports the real values before starting Compose, so these
# are mainly fallbacks for direct `docker compose up` usage.
HOST_UID=1000
HOST_GID=1000
USER_NAME=shoptalk
GROUP_NAME=shoptalk